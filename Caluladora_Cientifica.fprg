<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="calculadora_cientifica"/>
        <attribute name="authors" value="JOAOGABRIELDACRUZ"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-25 11:03:37 "/>
        <attribute name="created" value="Sk9BT0dBQlJJRUxEQUNSVVo7REYwMS1MQUIwMi0zMzsyMDI2LTA4LTIxOyIwODoxNzowNiAiOzMxODY="/>
